OAUTH2_CLIENT_ID=<client token>
OAUTH2_CLIENT_SECRET=<client secret>
OAUTH2_REDIRECT_URI=http://localhost:5000/api/callback
SQLALCHEMY_DATABASE_URI=postgresql://postgres@localhost/autochannel
AC_TOKEN=<token>
# Optional: where OAuth redirects send the browser. Leave empty when Flask serves the
# built frontend; set to http://localhost:5173 when using the Vite dev server.
FRONTEND_URL=
# Optional: session signing key (defaults to OAUTH2_CLIENT_SECRET).
SECRET_KEY=
